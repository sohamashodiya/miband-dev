@@ -44,6 +44,17 @@ export const DATA_SOURCES: Record<DataSourceKey, DataSourceDefinition> = {
   sleepScore: { key: 'sleepScore', fprjId: '0828', label: 'Sleep score', minimum: 0, maximum: 100, evidence: 'reverse-engineered' },
 }
 
+// Long FPRJ source IDs are "<modifier><base>": m0tral's compiler (FaceItemDataSrc.Parse) adds the
+// modifier to the last four hex digits, e.g. 40009031 (°F) -> 0x4000 + 0x9031 = D031 and
+// 1000911 (hour high digit) -> 0x0100 + 0x0911 = 0A11, which matches the table above.
+export function normalizeDataSource(source: string): string {
+  const hex = source.replace(/[^0-9a-f]/gi, '').toUpperCase()
+  if (hex.length <= 4) return hex
+  const sum = parseInt(hex.slice(-4), 16) + parseInt(hex.slice(0, -4), 16)
+  if (sum > 0xffff) throw new Error(`Data source ${source} does not fold into 16 bits`)
+  return sum.toString(16).toUpperCase().padStart(4, '0')
+}
