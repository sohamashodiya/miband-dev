+// A script resource: u24 data length, u8 path length, 16 zero bytes, the path ("lua/<file>"), then
+// the file bytes. Byte-identical to m0tral's EasyFace output for a compiled Lua face sample.
+function scriptBlock(name: string, data: Uint8Array): Uint8Array {
+  const pathBytes = new TextEncoder().encode(name)
+  if (data.length > 0xffffff || pathBytes.length > 0xff) throw new Error(`Script file too large for the format: ${name}`)
+  const block = new Uint8Array(20 + pathBytes.length + data.length)
+  writeU24LE(block, 0, data.length)
+  block[3] = pathBytes.length
+  block.set(pathBytes, 20)
+  block.set(data, 20 + pathBytes.length)
+  return block
+}
