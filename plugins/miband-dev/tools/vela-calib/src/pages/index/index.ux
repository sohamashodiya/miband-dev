.root {
  width: 336px;
  height: 480px;
  background-color: #000000;
}

.pg {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 336px;
  height: 480px;
}

.rl {
  position: absolute;
  left: 0px;
